# DynastyX Esports Tactical Planner - Environment Variables
# Vercel Deployment Configuration

# Optional: Custom WebRTC TURN Server Credentials (Default: Free Metered TURN Relays)
VITE_TURN_SERVER_URL=turn:openrelay.metered.ca:80
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_CREDENTIAL=openrelayproject

# Optional: Supabase Realtime / Pusher fallback for serverless state sync
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_PUSHER_KEY=your-pusher-key
VITE_PUSHER_CLUSTER=ap2
